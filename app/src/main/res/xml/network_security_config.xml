<?xml version="1.0" encoding="utf-8"?>
<!--
  Everything the app talks to (the Claude API, Open Food Facts) is HTTPS, so there is nothing to
  allow cleartext for. This exists to make that explicit rather than relying on the platform
  default.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
