<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The user points the app at their own Ollama server by IP (e.g.
         http://192.168.1.20:11434), which is plain HTTP on the LAN, so cleartext
         must be allowed. TheMealDB and recipe links are still fetched over HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
