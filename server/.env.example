# Copy to .env and fill in. docker compose reads this file automatically.

# Shared secret the phone sends as `Authorization: Bearer <token>`.
# Generate one:  openssl rand -hex 32
KO_API_TOKEN=

# Where Ollama is, as seen from inside the container.
KO_OLLAMA_URL=http://host.docker.internal:11434

# Models per task. Pull them first:  ollama pull qwen2.5:7b-instruct
# gemma2:9b works but is noticeably weaker at structured output, which everything here relies on.
KO_MODEL_FAST=qwen2.5:3b
KO_MODEL_CHAT=qwen2.5:7b-instruct
KO_MODEL_RECIPE=qwen2.5:7b-instruct
KO_MODEL_NUTRITION=qwen2.5:7b-instruct

# -1 keeps the model resident so the first request each morning is not a 60s cold load.
KO_OLLAMA_KEEP_ALIVE=-1
KO_WARMUP_SECONDS=600

# Set while tuning prompts: re-reads ko_brain/prompts/*.md on every request.
# KO_RELOAD_PROMPTS=1
