# Copy to .env and fill in. Never commit the real .env.

# Shared bearer token the phone sends (Settings -> NAS sync). Any long random string works,
# e.g. `openssl rand -hex 32`. Required once KO_PUBLIC_URL is set.
KO_API_TOKEN=

# The public HTTPS address Tailscale Funnel gives this NAS, no trailing slash, e.g.
# https://nas.tail1234.ts.net:8443  (see `tailscale funnel status`). Leave empty for tailnet-only.
KO_PUBLIC_URL=

# Google sign-in for Claude's connector. Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials with the redirect URI
#   <KO_PUBLIC_URL>/auth/callback
KO_GOOGLE_CLIENT_ID=
KO_GOOGLE_CLIENT_SECRET=

# Which Google accounts may use the connector (comma-separated). Everyone else is refused.
KO_ALLOWED_EMAILS=
